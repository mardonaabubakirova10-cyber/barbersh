{
  "name": "barbershop-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "next": "^14.2.24",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {},
  "scripts": {
    "dev": "npm --workspace=apps/web run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:api": "npm --workspace=@barbershop/api run dev",
    "dev:miniapp": "npm --workspace=@barbershop/miniapp run dev",
    "build": "npx prisma generate --schema=packages/db/prisma/schema.prisma && npm --workspace=apps/web run build",
    "build:web": "npx prisma generate --schema=packages/db/prisma/schema.prisma && npm --workspace=apps/web run build",
    "build:miniapp": "npm --workspace=@barbershop/miniapp run build",
    "start": "npm --workspace=apps/web run start",
    "start:web": "npm --workspace=apps/web run start",
    "start:api": "npm --workspace=@barbershop/api run start",
    "db:push": "npm --workspace=@barbershop/db run db:push",
    "db:seed": "npm --workspace=@barbershop/db run db:seed",
    "db:studio": "npm --workspace=@barbershop/db run studio",
    "db:generate": "npm --workspace=@barbershop/db run generate"
  },
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma"
  }
}
